# Configuration du endpoint PHP de contact sur le VPS.
# Ne jamais committer le fichier .env réel ni ces valeurs dans le JavaScript public.

SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=remplacer_par_votre_identifiant_smtp2go
SMTP_PASSWORD=remplacer_par_votre_mot_de_passe_smtp2go

# Adresse qui reçoit les demandes.
CONTACT_EMAIL=contact@maddevops.com

# Adresse expéditrice validée dans SMTP2GO.
CONTACT_FROM_EMAIL=contact@maddevops.com
